<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.NearbyItemsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:StarterApp.ViewModels"
             x:Name="NearbyRoot"
             x:DataType="viewmodels:NearbyItemsViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     Command="{Binding NavigateToDashboardCommand}"
                     IconImageSource="home.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <StackLayout Grid.Row="0" Padding="20,16" Spacing="12">
            <Frame BackgroundColor="#dc3545"
                   IsVisible="{Binding HasError}"
                   Padding="15"
                   CornerRadius="8"
                   HasShadow="False">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="White"
                       FontSize="14" />
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackLayout Grid.Column="0">
                    <Label Text="Latitude"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Entry Text="{Binding LatitudeText}"
                           Keyboard="Numeric"
                           Placeholder="55.9533" />
                </StackLayout>

                <StackLayout Grid.Column="1">
                    <Label Text="Longitude"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Entry Text="{Binding LongitudeText}"
                           Keyboard="Numeric"
                           Placeholder="-3.1883" />
                </StackLayout>
            </Grid>

            <StackLayout>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Radius"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label Grid.Column="1"
                           Text="{Binding RadiusDisplay}"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold" />
                </Grid>
                <Slider Minimum="1"
                        Maximum="50"
                        Value="{Binding RadiusKm}" />
            </StackLayout>

            <StackLayout>
                <Label Text="Category"
                       FontAttributes="Bold"
                       FontSize="13" />
                <Entry Text="{Binding Category}"
                       Placeholder="tools, camping, sports..." />
            </StackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Use My Location"
                        Command="{Binding UseCurrentLocationCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="Search"
                        Command="{Binding SearchNearbyCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48" />
            </Grid>

            <Label Text="{Binding LocationSummary}"
                   FontSize="12"
                   TextColor="Gray" />
        </StackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding SearchNearbyCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No nearby items found"
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:NearbyItemListItem">
                        <Grid Padding="15,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference NearbyRoot}, Path=BindingContext.ViewItemCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding DailyRateDisplay}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Grid>

                            <Label Grid.Row="1"
                                   Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="Gray"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Margin="0,4,0,0" />

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                <Label Text="{Binding Category}"
                                       FontSize="13"
                                       TextColor="DodgerBlue" />
                                <Label Grid.Column="1"
                                       Text="{Binding DistanceDisplay}"
                                       FontSize="13"
                                       TextColor="Gray" />
                            </Grid>

                            <Label Grid.Row="3"
                                   Text="{Binding OwnerName}"
                                   FontSize="12"
                                   TextColor="Gray"
                                   Margin="0,4,0,0" />

                            <BoxView Grid.Row="4"
                                     BackgroundColor="LightGray"
                                     HeightRequest="1"
                                     Margin="0,12,0,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.RowSpan="2"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>

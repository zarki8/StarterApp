<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.ItemDetailPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     Command="{Binding NavigateToDashboardCommand}"
                     IconImageSource="home.png" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Grid Padding="20" RowSpacing="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ActivityIndicator Grid.Row="0"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <StackLayout Grid.Row="1" Spacing="10">
                <Frame BackgroundColor="#dc3545"
                       IsVisible="{Binding HasError}"
                       Padding="15"
                       CornerRadius="8"
                       HasShadow="False">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="White"
                           FontSize="14" />
                </Frame>

                <Frame BackgroundColor="#28a745"
                       IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}"
                       Padding="15"
                       CornerRadius="8"
                       HasShadow="False">
                    <Label Text="{Binding SuccessMessage}"
                           TextColor="White"
                           FontSize="14" />
                </Frame>
            </StackLayout>

            <StackLayout Grid.Row="2" Spacing="15">
                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True">
                    <StackLayout Spacing="15">
                        <Label Text="Item Information"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <StackLayout>
                            <Label Text="Title"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Entry Text="{Binding ItemTitle}"
                                   Placeholder="Enter item title"
                                   IsEnabled="{Binding CanEdit}" />
                        </StackLayout>

                        <StackLayout>
                            <Label Text="Description"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Editor Text="{Binding Description}"
                                    Placeholder="Describe the item"
                                    AutoSize="TextChanges"
                                    HeightRequest="120"
                                    IsEnabled="{Binding CanEdit}" />
                        </StackLayout>

                        <StackLayout>
                            <Label Text="Daily Rate"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Entry Text="{Binding DailyRate}"
                                   Placeholder="Enter daily rate"
                                   Keyboard="Numeric"
                                   IsEnabled="{Binding CanEdit}" />
                        </StackLayout>

                        <StackLayout>
                            <Label Text="Category"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Entry Text="{Binding Category}"
                                   Placeholder="Tools, Camping, Sports, Electronics, or Games"
                                   IsEnabled="{Binding CanEdit}" />
                        </StackLayout>

                        <StackLayout>
                            <Label Text="Location Coordinates"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Entry Text="{Binding Location}"
                                   Placeholder="55.9533, -3.1883"
                                   IsEnabled="{Binding CanEdit}" />
                        </StackLayout>

                        <StackLayout IsVisible="{Binding IsNewItem, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="Owner"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Text="{Binding OwnerName}"
                                   FontSize="16"
                                   TextColor="Gray" />
                        </StackLayout>

                        <Label Text="Only the owner can edit this item."
                               FontSize="13"
                               TextColor="Gray"
                               IsVisible="{Binding CanEdit, Converter={StaticResource InvertedBoolConverter}}" />

                        <Button Text="View Reviews"
                                Command="{Binding ViewReviewsCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                IsVisible="{Binding IsNewItem, Converter={StaticResource InvertedBoolConverter}}" />
                    </StackLayout>
                </Frame>
            </StackLayout>

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="15"
                  Margin="0,20,0,0">

                <Button Grid.Column="0"
                        Text="Back"
                        Command="{Binding BackCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand" />

                <Button Grid.Column="1"
                        Text="Save"
                        Command="{Binding SaveItemCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding CanEdit}" />

                <Button Grid.Column="1"
                        Text="Request Rental"
                        Command="{Binding RequestRentalCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="{Binding CanRequestRental}" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>

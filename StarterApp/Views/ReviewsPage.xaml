<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.ReviewsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:StarterApp.ViewModels"
             x:DataType="viewmodels:ReviewsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="16">
            <Frame BackgroundColor="#dc3545"
                   IsVisible="{Binding HasError}"
                   Padding="15"
                   CornerRadius="8"
                   HasShadow="False">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="White"
                       FontSize="14" />
            </Frame>

            <Frame BackgroundColor="#28a745"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}"
                   Padding="15"
                   CornerRadius="8"
                   HasShadow="False">
                <Label Text="{Binding SuccessMessage}"
                       TextColor="White"
                       FontSize="14" />
            </Frame>

            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                   Padding="20"
                   CornerRadius="12"
                   HasShadow="True"
                   IsVisible="{Binding CanSubmitReview}">
                <StackLayout Spacing="14">
                    <Label Text="Submit Review"
                           FontSize="18"
                           FontAttributes="Bold" />
                    <Label Text="{Binding ItemTitle}"
                           FontSize="16"
                           TextColor="Gray" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Rating"
                               FontAttributes="Bold" />
                        <Label Grid.Column="1"
                               Text="{Binding RatingDisplay}"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold" />
                    </Grid>
                    <Slider Minimum="1"
                            Maximum="5"
                            Value="{Binding Rating}" />
                    <Editor Text="{Binding Comment}"
                            Placeholder="Comment"
                            AutoSize="TextChanges"
                            HeightRequest="100" />
                    <Button Text="Submit Review"
                            Command="{Binding SubmitReviewCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="48" />
                </StackLayout>
            </Frame>

            <Label Text="Item Reviews"
                   FontSize="20"
                   FontAttributes="Bold"
                   IsVisible="{Binding CanViewItemReviews}" />

            <CollectionView ItemsSource="{Binding Reviews}"
                            IsVisible="{Binding CanViewItemReviews}"
                            HeightRequest="420">
                <CollectionView.EmptyView>
                    <Label Text="No reviews yet"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ReviewListItem">
                        <Grid Padding="0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ReviewerName}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Grid.Column="1"
                                       Text="{Binding RatingDisplay}"
                                       TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold" />
                            </Grid>
                            <Label Grid.Row="1"
                                   Text="{Binding Comment}"
                                   FontSize="14"
                                   TextColor="Gray" />
                            <Label Grid.Row="2"
                                   Text="{Binding CreatedAtDisplay}"
                                   FontSize="12"
                                   TextColor="Gray" />
                            <BoxView Grid.Row="3"
                                     BackgroundColor="LightGray"
                                     HeightRequest="1"
                                     Margin="0,10,0,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Back"
                    Command="{Binding BackCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                    HeightRequest="48" />
        </StackLayout>
    </ScrollView>
</ContentPage>

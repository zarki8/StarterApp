<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.RentalsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:StarterApp.ViewModels"
             x:Name="RentalsRoot"
             x:DataType="viewmodels:RentalsViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Home"
                     Command="{Binding NavigateToDashboardCommand}"
                     IconImageSource="home.png" />
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadRentalsCommand}">
            <ScrollView>
                <StackLayout Padding="20" Spacing="22">
                    <Frame BackgroundColor="#dc3545"
                           IsVisible="{Binding HasError}"
                           Padding="15"
                           CornerRadius="8"
                           HasShadow="False">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="White"
                               FontSize="14" />
                    </Frame>

                    <Frame BackgroundColor="#28a745"
                           IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}"
                           Padding="15"
                           CornerRadius="8"
                           HasShadow="False">
                        <Label Text="{Binding SuccessMessage}"
                               TextColor="White"
                               FontSize="14" />
                    </Frame>

                    <Label Text="Incoming requests"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding IncomingRentals}"
                                    SelectionMode="None"
                                    HeightRequest="280">
                        <CollectionView.EmptyView>
                            <Label Text="No incoming rentals"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:RentalListItem">
                                <Grid Padding="0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ItemTitle}"
                                               FontSize="17"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalPrice}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Grid>
                                    <Label Grid.Row="1"
                                           Text="{Binding DateRange}"
                                           FontSize="13"
                                           TextColor="Gray" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Text="{Binding PersonDisplay}"
                                               FontSize="13" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Status}"
                                               FontSize="13"
                                               TextColor="DodgerBlue" />
                                    </Grid>
                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="10"
                                          Margin="0,10,0,0"
                                          IsVisible="{Binding HasWorkflowAction}">
                                        <Button Grid.Column="0"
                                                Text="Reject"
                                                Command="{Binding Source={x:Reference RentalsRoot}, Path=BindingContext.RejectRentalCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#dc3545"
                                                TextColor="White"
                                                FontSize="13"
                                                HeightRequest="42"
                                                IsVisible="{Binding CanApproveOrReject}" />
                                        <Button Grid.Column="1"
                                                Text="Approve"
                                                Command="{Binding Source={x:Reference RentalsRoot}, Path=BindingContext.ApproveRentalCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="13"
                                                HeightRequest="42"
                                                IsVisible="{Binding CanApproveOrReject}" />
                                        <Button Grid.ColumnSpan="2"
                                                Text="Mark Out for Rent"
                                                Command="{Binding Source={x:Reference RentalsRoot}, Path=BindingContext.MarkOutForRentCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="13"
                                                HeightRequest="42"
                                                IsVisible="{Binding CanMarkOutForRent}" />
                                        <Button Grid.ColumnSpan="2"
                                                Text="Complete Rental"
                                                Command="{Binding Source={x:Reference RentalsRoot}, Path=BindingContext.CompleteRentalCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="13"
                                                HeightRequest="42"
                                                IsVisible="{Binding CanComplete}" />
                                    </Grid>
                                    <BoxView Grid.Row="4"
                                             BackgroundColor="LightGray"
                                             HeightRequest="1"
                                             Margin="0,10,0,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Outgoing requests"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding OutgoingRentals}"
                                    SelectionMode="None"
                                    HeightRequest="280">
                        <CollectionView.EmptyView>
                            <Label Text="No outgoing rentals"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:RentalListItem">
                                <Grid Padding="0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding ItemTitle}"
                                               FontSize="17"
                                               FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalPrice}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}" />
                                    </Grid>
                                    <Label Grid.Row="1"
                                           Text="{Binding DateRange}"
                                           FontSize="13"
                                           TextColor="Gray" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Text="{Binding PersonDisplay}"
                                               FontSize="13" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Status}"
                                               FontSize="13"
                                               TextColor="DodgerBlue" />
                                    </Grid>
                                    <Grid Grid.Row="3"
                                          Margin="0,10,0,0"
                                          IsVisible="{Binding HasWorkflowAction}">
                                        <Button Text="Mark Returned"
                                                Command="{Binding Source={x:Reference RentalsRoot}, Path=BindingContext.MarkReturnedCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="13"
                                                HeightRequest="42"
                                                IsVisible="{Binding CanMarkReturned}" />
                                        <Button Text="Review Rental"
                                                Command="{Binding Source={x:Reference RentalsRoot}, Path=BindingContext.ReviewRentalCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                FontSize="13"
                                                HeightRequest="42"
                                                IsVisible="{Binding CanReview}" />
                                    </Grid>
                                    <BoxView Grid.Row="4"
                                             BackgroundColor="LightGray"
                                             HeightRequest="1"
                                             Margin="0,10,0,0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </ScrollView>
        </RefreshView>

        <ActivityIndicator IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="StarterApp.Views.RentalRequestPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding Title}">

    <ScrollView>
        <Grid Padding="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ActivityIndicator Grid.Row="0"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <StackLayout Grid.Row="1" Spacing="10">
                <Frame BackgroundColor="#dc3545"
                       IsVisible="{Binding HasError}"
                       Padding="15"
                       CornerRadius="8"
                       HasShadow="False">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="White"
                           FontSize="14" />
                </Frame>

                <Frame BackgroundColor="#28a745"
                       IsVisible="{Binding SuccessMessage, Converter={StaticResource StringToBoolConverter}}"
                       Padding="15"
                       CornerRadius="8"
                       HasShadow="False">
                    <Label Text="{Binding SuccessMessage}"
                           TextColor="White"
                           FontSize="14" />
                </Frame>
            </StackLayout>

            <Frame Grid.Row="2"
                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                   Padding="20"
                   CornerRadius="12"
                   HasShadow="True">
                <StackLayout Spacing="16">
                    <Label Text="{Binding ItemTitle}"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*">
                        <StackLayout Grid.Column="0">
                            <Label Text="Daily rate"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Text="{Binding DailyRateDisplay}"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold" />
                        </StackLayout>

                        <StackLayout Grid.Column="1">
                            <Label Text="Owner"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Text="{Binding OwnerName}"
                                   TextColor="Gray" />
                        </StackLayout>
                    </Grid>

                    <StackLayout>
                        <Label Text="Start date"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <DatePicker Date="{Binding StartDate}"
                                    MinimumDate="{Binding MinimumDate}" />
                    </StackLayout>

                    <StackLayout>
                        <Label Text="End date"
                               FontAttributes="Bold"
                               FontSize="14" />
                        <DatePicker Date="{Binding EndDate}"
                                    MinimumDate="{Binding MinimumDate}" />
                    </StackLayout>

                    <Label Text="{Binding EstimatedTotalDisplay}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                </StackLayout>
            </Frame>

            <StackLayout Grid.Row="3"
                         Orientation="Horizontal"
                         Spacing="12"
                         Margin="0,8,0,0">
                <Button Text="Back"
                        Command="{Binding BackCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand" />

                <Button Text="Send Request"
                        Command="{Binding SubmitRequestCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        HorizontalOptions="FillAndExpand" />
            </StackLayout>

            <Button Grid.Row="4"
                    Text="View My Rentals"
                    Command="{Binding ViewRentalsCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}" />
        </Grid>
    </ScrollView>
</ContentPage>
